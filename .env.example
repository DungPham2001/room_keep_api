NODE_ENV=development
PORT=4000
# Same Atlas cluster as the other apps, one database per app: roomkeep
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/roomkeep?retryWrites=true&w=majority
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CORS_ORIGINS=
TIMEZONE=Asia/Ho_Chi_Minh

# App version gate (GET /v1/health, header X-App-Version -> 426 when older than MIN_APP_VERSION)
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0

# Public URL of this API (used in the reset-password email and the web account-deletion link)
PUBLIC_BASE_URL=

# Sessions (feature 144). Access token 2h, refresh token sliding 3h of inactivity, absolute session 12h.
ACCESS_TOKEN_MINUTES=120
REFRESH_IDLE_MINUTES=180
SESSION_MAX_HOURS=12
MAX_SESSIONS_PER_ACCOUNT=10

# Password reset email (feature 140). When SMTP_HOST is empty, outside production the reset code is returned as devToken.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RoomKeep <no-reply@example.com>
RESET_CODE_MINUTES=30
INVITE_HOURS=48

# Sync
SYNC_MAX_CHANGES=500
SYNC_MAX_RECORD_KB=64
TOMBSTONE_DAYS=90

# Optional: when set, /v1/jobs/daily requires "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it automatically)
CRON_SECRET=

# Per-IP limits. RATE_LIMIT=off disables them.
RATE_READ_PER_MIN=120
RATE_WRITE_PER_MIN=60
RATE_AUTH_PER_MIN=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
